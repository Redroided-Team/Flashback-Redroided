{
  "schemaVersion": 1,
  "id": "flashback_android",
  "version": "${version}",
  "name": "FBA - Flashback For Android",
  "description": "Flashback on Android. Runtime patches so Flashback replays, ImGui UI, file dialogs, exports and FFmpeg recording work on Android launchers. Requires the original Flashback mod, Fabric Loader and Fabric API.",
  "icon": "assets/flashback_android/icon.png",
  "environment": "client",

  "authors": [
    {
      "name": "WhalterMC",
      "contact": {
        "homepage": "https://whaltermc.vercel.app"
      }
    }
  ],

  "contributors": [
    {
      "name": "moulberry",
      "contact": {
        "homepage": "https://github.com/moulberry"
      }
    }
  ],

  "license": "All-Rights-Reserved",

  "contact": {
    "homepage": "https://whaltermc.vercel.app/fba",
    "sources": "https://github.com/Redroided-Team/Flashback-Redroided",
    "issues": "https://github.com/Redroided-Team/Flashback-Redroided/issues",
    "discord": "https://discord.gg/dKgFxHKc7T"
  },

  "entrypoints": {
    "main": [
      "com.whaltermc.FlashbackRedroided"
    ],
    "client": [
      "com.whaltermc.FlashbackRedroidedClient"
    ],
    "preLaunch": [
      "com.whaltermc.FlashbackPreLaunch"
    ]
  },

  "mixins": [
    "flashback_android.client.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.16",
    "minecraft": ">=26.1 <26.3",
    "fabric-api": "*",
    "flashback": "*"
  },

  "custom": {
    "modmenu": {
      "parent": "flashback"
    }
  }
}